   "resource_name": "notes",
   "resource_type": "API Resource",
   "transform": "function transform(notes) {\n\treturn (notes || []).map(function (note) {\n\t\tconst text = new DOMParser().parseFromString(note.content || \"\", \"text/html\").body.textContent || \"\"\n\t\treturn { ...note, preview: text.replace(/\\s+/g, \" \").trim() }\n\t})\n}",
   "url": "frappe.client.get_list"
  },
